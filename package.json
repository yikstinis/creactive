{
  "name": "creactive",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "example"
  ],
  "scripts": {
    "lint": "eslint . && tsc --noEmit",
    "test": "jest",
    "test:visual:web": "npm run --workspace example export:web && playwright test",
    "test:visual:web:update": "npm run --workspace example export:web && playwright test --update-snapshots",
    "test:visual:ios": "npm run --workspace example test:visual:ios",
    "test:visual:android": "npm run --workspace example test:visual:android",
    "test:visual:android:update": "npm run --workspace example test:visual:android:update"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": ">=0.86"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.56.0",
    "@react-native/babel-preset": "^0.86.3",
    "@react-native/jest-preset": "^0.86.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "^0.86.3",
    "react-native-web": "^0.21.2",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
